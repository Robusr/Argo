# Argo项目.gitattributes配置文件
# 适配Git LFS，追踪超过100MB的大文件，对应DEV_SPEC.md中Git LFS使用规范
# SolidWorks相关文件（零件、装配体、工程图）
*.SLDPRT filter=lfs diff=lfs merge=lfs -text
*.SLDASM filter=lfs diff=lfs merge=lfs -text
*.SLDDRW filter=lfs diff=lfs merge=lfs -text

# Ansys相关文件（项目文件、数据库、结果文件）
*.wbpj filter=lfs diff=lfs merge=lfs -text
*.wbdb filter=lfs diff=lfs merge=lfs -text
*.rst filter=lfs diff=lfs merge=lfs -text
*.rth filter=lfs diff=lfs merge=lfs -text
*.cdb filter=lfs diff=lfs merge=lfs -text

# 大型仿真数据文件（超过100MB的mat、csv文件）
*.mat filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text

# 其他大型文件（PCB设计相关、3D导出文件）
*.PcbDoc filter=lfs diff=lfs merge=lfs -text
*.SchDoc filter=lfs diff=lfs merge=lfs -text
*.STEP filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text

# 文档及代码文件，不使用LFS追踪
*.md text
*.py text
*.c text
*.h text
*.cpp text
*.hpp text
*.m text
*.ini text
*.xlsx text
*.pdf text
*.txt text

# 配置文件，不使用LFS追踪
.gitignore text
.gitattributes text
LICENSE text
requirements.txt text
setup.py text

# 编译产物及临时文件，已在.gitignore中忽略，此处无需配置LFS
*.exe -text
*.bin -text
*.hex -text
*.obj -text
*.o -text
*.~ -text
.DS_Store -text
Thumbs.db -text